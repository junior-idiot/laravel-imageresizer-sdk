{
  "name": "fromjun/laravel-imageresizer-sdk",
  "description": "Laravel SDK для Image Resizer Service",
  "type": "library",
  "license": "MIT",
  "version": "1.0.2",
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1",
    "illuminate/support": "^11.0 || ^12.0",
    "m1n64/imageresizer-sdk": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "M1n64\\LaravelImageResizer\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "M1n64\\LaravelImageResizer\\Providers\\ImageResizerServiceProvider"
      ],
      "aliases": {
        "ImageResizer": "M1n64\\LaravelImageResizer\\Facades\\ImageResizer"
      }
    }
  }
}
